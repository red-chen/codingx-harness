{
  "name": "codingx",
  "version": "0.1.0",
  "description": "Terminal AI coding agent harness",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "codingx": "bin/codingx.js"
  },
  "main": "dist/main.js",
  "exports": {
    ".": "./dist/main.js"
  },
  "files": [
    "bin",
    "dist",
    "plugins",
    "docs",
    "README.md",
    "LICENSE",
    "scripts/fix-node-pty.mjs"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build",
    "check": "npm run typecheck && npm test",
    "postinstall": "node scripts/fix-node-pty.mjs"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "fast-glob": "^3.3.3",
    "ignore": "^7.0.14",
    "node-pty": "^1.1.0",
    "parse5": "^8.0.1",
    "smol-toml": "^1.9.1",
    "string-width": "^8.3.0",
    "yaml": "^2.9.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@xterm/headless": "^6.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
